DATABASE_URL="postgresql://galcis:galcis@localhost:5432/galcis"
PORT=3000

# LLM tier config — provider inferred from model name prefix:
#   claude-*   → Anthropic  (requires ANTHROPIC_API_KEY)
#   gpt-* o1-* o3-* o4-* → OpenAI (requires OPENAI_API_KEY)
#   gemini-*   → Google     (requires GOOGLE_API_KEY)
LLM_TIER1_MODEL="claude-haiku-4-5-20251001"
LLM_TIER2_MODEL="claude-sonnet-4-6"

ANTHROPIC_API_KEY="your-key-here"
# OPENAI_API_KEY="your-key-here"
# GOOGLE_API_KEY="your-key-here"
